<template>
  <div class="page">
    <text class="title">{{title}}</text>
    <div class="grid">
      <div class="tile {{m.id === selected ? 'tile-on' : ''}} {{fxId === m.id ? 'tile-fx' : ''}}" for="m in moods" onclick="pick(m.id)">
        <image class="tile-img" src="/common/emoji/{{m.id}}.png"></image>
        <text class="tile-text">{{m.label}}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { MOODS } from '../../common/data.js'

export default {
  private: {
    moods: MOODS,
    selected: '',
    title: '我现在…',
    fxId: ''
  },

  onInit() {
    this.store = this.$app.$def.store
    this.selected = (this.store.state.me && this.store.state.me.mood) || ''
  },

  pick(id) {
    this.selected = id
    this.fxId = id
    vibrator.vibrate({ mode: 'short' })
    this.store.state.me.mood = id
    this.store.send({ t: 'mood', mood: id }, ok => {
      this.title = ok ? '已告诉 TA ✓' : '手机没连上'
      setTimeout(() => { this.fxId = '' }, 500)
      setTimeout(() => router.back(), ok ? 700 : 1500)
    })
  }
}
</script>

<style>
@import '../../common/base.css';

.title { height: 56px; padding-top: 18px; font-size: 22px; }
.grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 12px;
}
.tile {
  width: 100px;
  height: 70px;
  margin-bottom: 8px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #1e1824;
  border-radius: 18px;
  border-width: 2px;
  border-color: #1e1824;
}
.tile-on {
  background-color: #2c2236;
  border-color: #b79cff;
}
.tile-fx {
  background-color: #3a2a48;
  border-color: #ff8fb8;
}
.tile-img { width: 28px; height: 28px; }
.tile-text { font-size: 16px; color: #ffffff; margin-top: 2px; }
</style>
