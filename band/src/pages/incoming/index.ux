<template>
  <div class="page">
    <div class="stage">
      <div class="ring1 {{pulse ? 'ring1-on' : ''}}">
        <div class="ring2 {{pulse ? 'ring2-on' : ''}}">
          <div class="core">
            <image class="core-img" src="{{icon}}"></image>
          </div>
        </div>
      </div>
      <image class="heart h1" src="/common/emoji/heart.png"></image>
      <image class="heart h2" src="/common/emoji/hearts.png"></image>
      <image class="heart h3" src="/common/emoji/sparkle.png"></image>
    </div>
    <text class="headline">
      <span class="who">{{from}} </span><span class="what">{{what}}</span>
    </text>
    <text class="meta">{{meta}}</text>
    <div class="actions">
      <div class="reply" onclick="reply">
        <image class="reply-img" src="/common/emoji/heart.png"></image>
        <text class="reply-text">{{replyLabel}}</text>
      </div>
      <div class="ok" onclick="gotIt">
        <text class="ok-text">收到</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { describeIncoming, emojiSrc } from '../../common/logic.js'

export default {
  private: {
    icon: '/common/emoji/miss.png',
    from: 'TA',
    what: '想你了',
    meta: '刚刚',
    pulse: false,
    replyLabel: '回一个'
  },

  onInit() {
    this.store = this.$app.$def.store
    this.listener = (st, msg) => { if (msg && msg.t === 'incoming') this.show(msg) }
  },

  onShow() {
    this.store.incomingOpen = true
    this.store.on(this.listener)
    this.show(this.store.state.lastIncoming)
  },

  onHide() { this.leave() },
  onDestroy() { this.leave() },

  leave() {
    this.store.incomingOpen = false
    this.store.off(this.listener)
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },

  show(ev) {
    if (!ev) return
    const d = describeIncoming(ev, Date.now())
    const p = this.store.state.partner || {}
    this.from = ev.from || p.name || 'TA'
    this.what = d.title
    this.meta = d.meta
    this.icon = emojiSrc(d.icon)
    // pulse rings for ~5s
    if (this.timer) clearInterval(this.timer)
    let n = 0
    this.timer = setInterval(() => {
      this.pulse = !this.pulse
      if (++n >= 10) { clearInterval(this.timer); this.timer = null; this.pulse = false }
    }, 500)
  },

  reply() {
    vibrator.vibrate({ mode: 'short' })
    this.replyLabel = '已回 💗'
    this.store.send({ t: 'miss', level: 'short' }, () => {
      setTimeout(() => router.back(), 600)
    })
  },

  gotIt() {
    this.store.send({ t: 'ack' })
    router.back()
  }
}
</script>

