  width: 336px;
  height: 250px;
  justify-content: center;
  align-items: center;
}
.ring1 {
  width: 212px;
  height: 212px;
  border-radius: 106px;
  border-width: 2px;
  border-color: #3a2a48;
  justify-content: center;
  align-items: center;
}
.ring1-on { border-color: #f06a9f; }
.ring2 {
  width: 168px;
  height: 168px;
  border-radius: 84px;
  border-width: 3px;
  border-color: #6a4a8e;
  justify-content: center;
  align-items: center;
}
.ring2-on { border-color: #ff8fb8; }
.core {
  width: 124px;
  height: 124px;
  border-radius: 62px;
  border-width: 1px;
  border-color: #b79cff;
  background-color: #b79cff;
  justify-content: center;
  align-items: center;
}
.core-img { width: 72px; height: 72px; }
.heart { position: absolute; width: 26px; height: 26px; }
.h1 { left: 34px; top: 40px; }
.h2 { left: 272px; top: 70px; width: 30px; height: 30px; }
.h3 { left: 52px; top: 190px; width: 22px; height: 22px; }

.headline { text-align: center; font-size: 30px; font-weight: bold; margin-top: 8px; lines: 1; text-overflow: ellipsis; padding: 0 12px; }
.who { color: #ffffff; }
.what { color: #ff8fb8; }
.meta { text-align: center; font-size: 17px; color: #a99bb8; margin-top: 8px; lines: 1; padding: 0 12px; }

.actions {
  flex-direction: row;
  margin: 24px 16px 0 16px;
  height: 88px;
}
.reply {
  flex: 1.35;
  height: 88px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  background-color: #ff8fb8;
  border-radius: 44px;
  border-width: 1px;
  border-color: #ff8fb8;
}
.reply-img { width: 28px; height: 28px; }
.reply-text { font-size: 22px; color: #2a0f1e; font-weight: bold; margin-left: 6px; }
.ok {
  flex: 1;
  height: 88px;
  margin-left: 10px;
  justify-content: center;
  align-items: center;
  background-color: #1e1824;
  border-radius: 44px;
  border-width: 1px;
  border-color: #1e1824;
}
.ok-text { font-size: 22px; color: #ffffff; }
</style>
